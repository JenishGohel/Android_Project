<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayoutLoan"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#000000">

        <!-- TOOLBAR -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarLoan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#000000"
            app:title="Loan Calculator"
            app:titleTextColor="#FFFFFF"
            app:navigationIcon="@android:drawable/ic_menu_sort_by_size"/>

        <!-- CONTENT -->
        <TextView
            android:text="Loan Calculator"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etPrincipal"
            android:hint="Principal Amount"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:backgroundTint="#FFFFFF"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etRate"
            android:hint="Rate of Interest (%)"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:backgroundTint="#FFFFFF"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/etYears"
            android:hint="Loan Duration (Years)"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:backgroundTint="#FFFFFF"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnCalculateLoan"
            android:text="CALCULATE"
            android:layout_marginTop="16dp"/>

        <!-- RESULT -->
        <TextView
            android:id="@+id/tvEmi"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvInterest"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvTotal"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <!-- DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationViewLoan"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>
