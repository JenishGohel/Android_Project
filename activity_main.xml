<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ================= MAIN CONTENT ================= -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:background="#000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ================= TOOLBAR ================= -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#000000"
                app:title="Scientific Calculator"
                app:titleTextColor="#FFFFFF"
                android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

                <!-- HISTORY BUTTON (RIGHT SIDE) -->
                <ImageButton
                    android:id="@+id/btnHistory"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="16dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#FFFFFF"
                    android:contentDescription="History"/>
            </androidx.appcompat.widget.Toolbar>

            <!-- ================= DISPLAY AREA ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3.2"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingBottom="28dp">

                <TextView
                    android:id="@+id/tvModeIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEG"
                    android:textColor="#FF9F0A"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <!-- EQUATION (AUTO SCROLL READY) -->
                <HorizontalScrollView
                    android:id="@+id/scrollEquation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/tvEquation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#8E8E93"
                        android:textSize="22sp"
                        android:singleLine="true"/>
                </HorizontalScrollView>

                <!-- DISPLAY (AUTO SCROLL READY) -->
                <HorizontalScrollView
                    android:id="@+id/scrollDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:gravity="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="26sp"
                        android:autoSizeMaxTextSize="60sp"
                        android:autoSizeStepGranularity="2sp"/>
                </HorizontalScrollView>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"/>

            <!-- ================= KEYPAD ================= -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="6.8"
                android:stretchColumns="*"
                android:shrinkColumns="*"
                android:padding="6dp">

                <!-- ROW 1 -->
                <TableRow android:layout_weight="1">
                    <Button android:id="@+id/btnSin" android:text="sin" android:textSize="20sp" android:background="@drawable/btn_sci" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnCos" android:text="cos" android:textSize="20sp" android:background="@drawable/btn_sci" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnTan" android:text="tan" android:textSize="20sp" android:background="@drawable/btn_sci" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnDel" android:text="DEL" android:textSize="20sp" android:background="@drawable/btn_control" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnClear" android:text="C" android:textSize="20sp"
                        android:background="@drawable/btn_control"
                        android:backgroundTint="#FF453A"
                        android:textColor="#FFF"/>
                </TableRow>

                <!-- ROW 2 -->
                <TableRow android:layout_weight="1">
                    <Button android:id="@+id/btnLog" android:text="log" android:textSize="20sp" android:background="@drawable/btn_sci" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnLn" android:text="ln" android:textSize="20sp" android:background="@drawable/btn_sci" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnSqrt" android:text="√" android:textSize="20sp" android:background="@drawable/btn_sci" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnPower" android:text="xʸ" android:textSize="20sp" android:background="@drawable/btn_sci" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnDivide" android:text="÷" android:textSize="20sp" android:background="@drawable/btn_op" android:textColor="#FFF"/>
                </TableRow>

                <!-- ROW 3 -->
                <TableRow android:layout_weight="1">
                    <Button android:id="@+id/btn7" android:text="7" android:textSize="20sp" android:background="@drawable/btn_num" android:textColor="#FFF"/>
                    <Button android:id="@+id/btn8" android:text="8" android:textSize="20sp" android:background="@drawable/btn_num" android:textColor="#FFF"/>
                    <Button android:id="@+id/btn9" android:text="9" android:textSize="20sp" android:background="@drawable/btn_num" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnSq" android:text="x²" android:textSize="20sp" android:background="@drawable/btn_sci" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnMultiply" android:text="×" android:textSize="20sp" android:background="@drawable/btn_op" android:textColor="#FFF"/>
                </TableRow>

                <!-- ROW 4 -->
                <TableRow android:layout_weight="1">
                    <Button android:id="@+id/btn4" android:text="4" android:textSize="20sp" android:background="@drawable/btn_num" android:textColor="#FFF"/>
                    <Button android:id="@+id/btn5" android:text="5" android:textSize="20sp" android:background="@drawable/btn_num" android:textColor="#FFF"/>
                    <Button android:id="@+id/btn6" android:text="6" android:textSize="20sp" android:background="@drawable/btn_num" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnCube" android:text="x³" android:textSize="20sp" android:background="@drawable/btn_sci" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnMinus" android:text="−" android:textSize="20sp" android:background="@drawable/btn_op" android:textColor="#FFF"/>
                </TableRow>

                <!-- ROW 5 -->
                <TableRow android:layout_weight="1">
                    <Button android:id="@+id/btn1" android:text="1" android:textSize="20sp" android:background="@drawable/btn_num" android:textColor="#FFF"/>
                    <Button android:id="@+id/btn2" android:text="2" android:textSize="20sp" android:background="@drawable/btn_num" android:textColor="#FFF"/>
                    <Button android:id="@+id/btn3" android:text="3" android:textSize="20sp" android:background="@drawable/btn_num" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnMode" android:text="RAD" android:textSize="20sp" android:background="@drawable/btn_sci" android:textColor="#FFF"/>
                    <Button android:id="@+id/btnPlus" android:text="+" android:textSize="20sp" android:background="@drawable/btn_op" android:textColor="#FFF"/>
                </TableRow>

                <!-- ROW 6 -->
                <TableRow android:layout_weight="1">
                    <Button android:id="@+id/btn0"
                        android:text="0"
                        android:textSize="20sp"
                        android:layout_span="2"
                        android:background="@drawable/btn_num"
                        android:textColor="#FFF"/>
                    <Button android:id="@+id/btnDot"
                        android:text="."
                        android:textSize="20sp"
                        android:background="@drawable/btn_num"
                        android:textColor="#FFF"/>
                    <Button android:id="@+id/btnEquals"
                        android:text="="
                        android:textSize="20sp"
                        android:layout_span="2"
                        android:background="@drawable/btn_op"
                        android:textColor="#FFF"/>
                </TableRow>

            </TableLayout>

        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ================= NAV DRAWER ================= -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>
