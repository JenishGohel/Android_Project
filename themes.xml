<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ScientificCalculator" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <item name="colorPrimary">#FF9F0A</item>
        <item name="android:statusBarColor">#000000</item>
    </style>

    <style name="BaseBtn" parent="Widget.AppCompat.Button">
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="NumBtn" parent="BaseBtn">
        <item name="android:backgroundTint">#333333</item>
    </style>

    <style name="SciBtn" parent="BaseBtn">
        <item name="android:backgroundTint">#1C1C1E</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="OpBtn" parent="BaseBtn">
        <item name="android:backgroundTint">#FF9F0A</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="ControlBtn" parent="BaseBtn">
        <item name="android:backgroundTint">#A5A5A5</item>
        <item name="android:textColor">#000000</item>
    </style>
</resources>